# Provider peta: free (Leaflet/OpenStreetMap pada tahap berikutnya) atau google
VITE_MAP_PROVIDER=free

# Supabase akan digunakan untuk authentication, database, dan storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Nama lama yang masih didukung jika project memakai legacy anon key.
VITE_SUPABASE_ANON_KEY=

# Diisi hanya jika provider peta diubah ke Google Maps.
VITE_GOOGLE_MAPS_API_KEY=
